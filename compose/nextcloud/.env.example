# Copy this file to .env and replace every change-me value.
# Never commit .env to git.

NEXTCLOUD_VERSION=latest
NEXTCLOUD_PORT=8080

# Your server's Tailscale IP (run: tailscale ip -4)
SERVER_ADDRESS=100.x.y.z
NEXTCLOUD_TRUSTED_DOMAINS="100.x.y.z localhost"

# First admin account (min. 10 characters, not a common password)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

# Database (only reachable inside the Docker network)
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me

# Storage layout: small and fast things on the SSD, user files on the HDD
APP_DIR=/srv/nextcloud/html
CONFIG_DIR=/srv/nextcloud/config
DB_DIR=/srv/nextcloud/db
DATA_DIR=/mnt/hdd/nextcloud-data
