# Copy this file to .env and replace every change-me value.
# Never commit .env to git.

OPEN_WEBUI_TAG=main

# The name shown in the interface (your own branding)
WEBUI_NAME=MyAI

# Port for the web interface and API (Nextcloud already uses 8080)
PORT=3000

# Ollama runs on the host and listens on localhost only
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Keeps logins valid across restarts. Generate one with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# New sign-ups wait for admin approval
DEFAULT_USER_ROLE=pending

# false means the admin cannot read other users' chats
ENABLE_ADMIN_CHAT_ACCESS=false
